[Unit]
Description=BJUT campus network auto login
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bjut-auth --config /etc/bjut-auto-login.conf ensure
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/bjut-auto-login.conf
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
