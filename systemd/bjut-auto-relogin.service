[Unit]
Description=Force BJUT campus network logout and relogin
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bjut-relogin --config /etc/bjut-auto-login.conf relogin
TimeoutStartSec=240s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock
ReadOnlyPaths=/etc/bjut-auto-login.conf /usr/local/bin/bjut-auth
RestrictSUIDSGID=true
LockPersonality=true
